NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase dashboard → Project Settings → API Keys → service_role / secret key. Never commit this.
SUPABASE_SERVICE_ROLE_KEY=

# Optional email (Resend). Without RESEND_API_KEY, "Mark sent" only records sent_at.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Brightloop Billing <billing@your-domain.example>

# Overdue reminders: /api/cron/overdue-reminders (Vercel Cron, daily 09:00 IST).
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate a long random value.
CRON_SECRET=
# Reminders are only emailed when this is "true" AND RESEND_API_KEY is set; otherwise the run is a dry run.
# Keep it off while the database holds seeded demo customers.
REMINDERS_ENABLED=false
REMINDER_BATCH=50

# Live test suites (scripts/verify-*.cjs) sign in as the shared test admin.
DEMO_TEST_PASSWORD=
